# Copy to .env.localdb after `supabase start`, and fill the two keys from `supabase status -o env` (ANON_KEY, SERVICE_ROLE_KEY).
# Used by `npm run dev:localdb` (port 3210), the ingestion CLI (`--env .env.localdb`), and the database tests.
# Ports come from supabase/config.toml. Never copy these values into .env.local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55422/postgres
DEMO_MODE=false
NEXT_PUBLIC_SITE_URL=http://localhost:3210
# Any 32 random bytes, base64: `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=
