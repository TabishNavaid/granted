# Copy to .env.local. Nothing in .env.local is committed. See docs/setup.md for how to get each one.

# ---------- Required ----------

# Google Gemini, through the official @google/genai SDK. Get a key at https://aistudio.google.com/apikey
# Without it the agents cannot run; every screen still works on mock data.
GEMINI_API_KEY=

# Model overrides. Defaults (see src/lib/ai/gemini.ts): gemini-3.1-flash-lite for extraction, gemini-3.8-flash for scoring and letters.
# GEMINI_LITE_MODEL=
# GEMINI_STANDARD_MODEL=
# Embeddings for semantic matching over the opportunity database (default gemini-embedding-2, 768 dimensions).
# Ingestion embeds at most CATALOG_EMBED_MAX new or changed rows per run (default 3000). Without a key, search is full text only.
# GEMINI_EMBEDDING_MODEL=
# CATALOG_EMBED_MAX=

# Supabase: Project settings > API. The service role key stays on the server.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Where magic links send people back to. Must match a Redirect URL in Supabase Auth settings.
# Also the base for the OAuth callbacks and the links in emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Direct Postgres connection for ingestion and `npm run launch:db` (Supabase dashboard > Connect > Session pooler, port 5432).
# Local: postgresql://postgres:postgres@127.0.0.1:55422/postgres (see .env.localdb.example).
SUPABASE_DB_URL=
# A personal access token (supabase.com/dashboard/account/tokens). Only `npm run launch:db` uses it, to set auth URLs,
# email templates, Resend SMTP, and Google sign-in on the project. Never deployed to Vercel.
SUPABASE_ACCESS_TOKEN=

# DEMO_MODE=true forces mock data everywhere (the marketing demo). Unset, demo mode is on only when the Supabase keys are missing.
# With DEMO_MODE=true and a GEMINI_API_KEY, onboarding runs the real loop against in-memory state, which is handy for trying it without a database.
DEMO_MODE=

# ---------- Optional ----------

# Google OAuth client (Google Cloud > APIs and Services > Credentials). One client covers Google sign-in, Gmail send, and Google Calendar.
# Register <NEXT_PUBLIC_SITE_URL>/api/integrations/google/callback on it, and the Supabase callback for sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra app registration with Mail.Send and User.Read, for sending from Outlook.
# Register <NEXT_PUBLIC_SITE_URL>/api/integrations/microsoft/callback on it.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Resend, for email the product sends itself: the weekly digest and the contact form. Funder emails always go from the user's own account.
RESEND_API_KEY=
# The From address, on a domain verified in Resend. Falls back to onboarding@resend.dev, which only delivers to your own Resend account.
EMAIL_FROM=
# Where the /contact form delivers, and the address the page shows when email delivery is off.
NEXT_PUBLIC_CONTACT_EMAIL=

# Shared secret a scheduler sends to GET /api/cron/digest, as Authorization: Bearer or ?secret=. Generate with `openssl rand -hex 32`.
CRON_SECRET=

# Operators of this deployment, comma separated. They can open /admin/ingestion (the opportunity database job log) and /admin/errors.
ADMIN_EMAILS=

# Encrypts stored OAuth tokens (Gmail, Outlook, Google Calendar) with AES-256-GCM. Required before anyone connects an account.
# Generate with `openssl rand -base64 32`. To rotate, move the old value to TOKEN_ENCRYPTION_KEY_PREVIOUS.
TOKEN_ENCRYPTION_KEY=
# TOKEN_ENCRYPTION_KEY_PREVIOUS=

# Signs one-click unsubscribe links in emails. Falls back to CRON_SECRET. Generate with `openssl rand -hex 32`.
EMAIL_SIGNING_SECRET=

# ---------- Opportunity database ----------

# SAM.gov public API key (sam.gov > Account details > API key). Enables federal contract opportunities and the assistance catalog.
SAM_GOV_API_KEY=
# Smallest yearly giving for a private foundation to get full detail from its 990-PF. Lower values need a bigger database (see LAUNCH.md).
# IRS_990PF_MIN_GIVING=100000
# Optional: a free Socrata app token raises the request limit on city and state open data portals.
# SOCRATA_APP_TOKEN=
# CATALOG_MATCHING=off makes matching use the live source APIs instead of the database (for debugging).
# CATALOG_MATCHING=
